# Copy to deploy/secrets.env and fill in. deploy.sh will push these into Key Vault.
# Never commit the filled-in version.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_DEPLOYMENT=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Azure Communication Services (Email) ---
# Get the connection string from: Azure Portal > your ACS resource > Keys.
# ACS_SENDER_ADDRESS is the "from" address on the Email domain linked to the ACS resource.
# With the Azure-managed domain it is DoNotReply@<guid>.azurecomm.net.
ACS_CONNECTION_STRING=endpoint=https://xxx.communication.azure.com/;accesskey=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACS_SENDER_ADDRESS=DoNotReply@xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.azurecomm.net
USER_EMAIL=you@example.com

# --- Optional overrides ---
BLUESKY_HANDLES=karpathy.bsky.social,emollick.bsky.social,benedictevans.bsky.social
# YouTube channel IDs. Default is MKBHD (verified working).
# To add your own: visit the channel page → view page source → find "channelId":"UC...".
YOUTUBE_CHANNEL_IDS=UCBJycsmduvYEL83R_U4JriQ
GITHUB_TRENDING_LANGUAGE=
